  "01-02": {
    "reading_zh": [
      "图中人体呈斜前方视角，蓝边绿色透明板代表假想切面。先找贯穿头与躯干、把身体分成左和右的矢状面；图示接近正中位置，偏离正中的平行切面仍属于矢状面。",
      "另一个竖直面是冠状面，它分开身体前部和后部；腰部近水平的板是横断面，分开上部与下部。足踝附近倾斜的小板是斜面，说明实际观察也可以采用不平行于基本切面的方向。",
      "这些板不是人体中的真实膜或分隔，也没有画出切开后的内部组织。透明颜色和交线只为展示空间方向；阅读后续剖面时，还要另行确认切到的高度、前后和左右标记。"
    ],
    "labels": [
      {
        "en": "Sagittal plane",
        "zh": "矢状面",
        "note": "竖直经过身体并区分左侧与右侧"
      },
      {
        "en": "Frontal (coronal) plane",
        "zh": "额状面、冠状面",
        "note": "竖直经过身体并区分前部与后部"
      },
      {
        "en": "Transverse plane",
        "zh": "横断面",
        "note": "图中腰部水平切面区分上下部"
      },
      {
        "en": "Oblique plane",
        "zh": "斜面",
        "note": "图中足踝附近倾斜的切面示例"
      }
    ]
  },
  "01-03": {
    "reading_zh": [
      "先比较左侧面观与右前面观：红色颅腔向下接细长的椎管，左侧大括号把它们归为背侧体腔。它们的轮廓说明脑与脊髓的容纳空间，并不表示里面没有组织。",
      "再看胸部：紫色两侧区域标示胸膜腔的位置，中央上方是上纵隔，心包腔位于纵隔内。胸部下界的膈把胸腔与腹盆腔分开；粉色腹部与绿色盆部则向下连续。",
      "右侧大括号给出腹盆腔与腹侧体腔的归属关系。图把胸膜腔、心包腔画得宽大以便定位，真实正常浆膜腔只是薄的潜在间隙；区域色块不代表器官或液体的真实颜色。"
    ],
    "labels": [
      {
        "en": "Lateral view",
        "zh": "侧面观",
        "note": "左侧剖示图呈现体腔前后关系"
      },
      {
        "en": "Anterior view",
        "zh": "前面观",
        "note": "右侧图呈现胸腹与左右分区"
      },
      {
        "en": "Cranial cavity",
        "zh": "颅腔",
        "note": "颅骨内红色区域容纳脑组织"
      },
      {
        "en": "Vertebral cavity",
        "zh": "椎管",
        "note": "脊柱内细长通道容纳脊髓等结构"
      },
      {
        "en": "Dorsal body cavity",
        "zh": "背侧体腔",
        "note": "左侧括号合称颅腔与椎管"
      },
      {
        "en": "Thoracic cavity",
        "zh": "胸腔",
        "note": "位于膈上方并含纵隔及两侧区域"
      },
      {
        "en": "Superior mediastinum",
        "zh": "上纵隔",
        "note": "两肺之间纵隔较上部的区域"
      },
      {
        "en": "Pleural cavity",
        "zh": "胸膜腔",
        "note": "胸膜层间薄隙在图中被扩大显示"
      },
      {
        "en": "Pericardial cavity within the mediastinum",
        "zh": "纵隔内的心包腔",
        "note": "胸部中央心包浆膜层间的间隙"
      },
      {
        "en": "Diaphragm",
        "zh": "膈",
        "note": "胸腔与腹盆腔之间的肌性分隔"
      },
      {
        "en": "Abdominal cavity",
        "zh": "腹腔",
        "note": "膈下方盆腔上方的腹部空间"
      },
      {
        "en": "Pelvic cavity",
        "zh": "盆腔",
        "note": "腹腔向下连续进入骨盆内空间"
      },
      {
        "en": "Abdominopelvic cavity",
        "zh": "腹盆腔",
        "note": "右侧小括号概括腹腔与盆腔"
      },
      {
        "en": "Ventral body cavity (both thoracic and abdominopelvic cavities)",
        "zh": "腹侧体腔",
        "note": "右侧大括号概括胸腔及腹盆腔"
