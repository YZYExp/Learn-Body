  "02-01": {
    "reading_zh": [
      "中央人体图用引线把四类组织连接到代表位置，四周照片则显示不同组织的显微外观。先看左上神经组织与右上肌组织，再看左下紧密成层的上皮和右下含较多细胞间成分的结缔组织。",
      "同一类组织可以出现在多个位置：上皮既覆盖体表，也衬在消化管等空腔器官内面；肌组织分心肌、平滑肌和骨骼肌。右上的照片是心肌实例，并不是三类肌组织同时出现在同一照片里。",
      "骨、肌腱、脂肪都被列入结缔组织，是按组织构成和关系分类，而非只看软硬。引线表示举例定位，不是神经或血管路线；染色照片的粉紫色也不是组织在活体中的自然颜色。"
    ],
    "labels": [
      {
        "en": "Nervous tissue",
        "zh": "神经组织",
        "note": "左上照片及脑脊髓神经位置示例"
      },
      {
        "en": "Brain",
        "zh": "脑",
        "note": "人体头颅内的中枢神经结构"
      },
      {
        "en": "Spinal cord",
        "zh": "脊髓",
        "note": "位于椎管内并与脑连接的结构"
      },
      {
        "en": "Nerves",
        "zh": "神经",
        "note": "图中颈肩部黄色周围神经示例"
      },
      {
        "en": "Muscle tissue",
        "zh": "肌组织",
        "note": "右上以心肌照片示收缩组织"
      },
      {
        "en": "Cardiac muscle",
        "zh": "心肌",
        "note": "引线指向胸部中央心脏位置"
      },
      {
        "en": "Smooth muscle",
        "zh": "平滑肌",
        "note": "引线指向胃等内脏肌性结构"
      },
      {
        "en": "Skeletal muscle",
        "zh": "骨骼肌",
        "note": "引线指向上肢可随意活动的肌肉"
      },
      {
        "en": "Epithelial tissue",
        "zh": "上皮组织",
        "note": "左下照片显示细胞紧密成层"
      },
      {
        "en": "Lining of GI tract organs and other hollow organs",
        "zh": "消化道及其他空腔器官的衬里",
        "note": "GI为胃肠道缩写，指向肠内面"
      },
      {
        "en": "Skin surface (epidermis)",
        "zh": "皮肤表面（表皮）",
        "note": "人体外缘指线表示覆盖性上皮"
      },
      {
        "en": "Connective tissue",
        "zh": "结缔组织",
        "note": "右下照片示细胞与细胞外成分"
      },
      {
        "en": "Fat and other soft padding tissue",
        "zh": "脂肪及其他软性缓冲组织",
        "note": "引线表示肢体内的缓冲组织示例"
      },
      {
        "en": "Bone",
        "zh": "骨",
        "note": "引线指向肢体内骨性支架结构"
      },
      {
        "en": "Tendon",
        "zh": "肌腱",
        "note": "引线指向肌肉与附着处间索带"
      }
    ]
  },
  "02-02": {
    "reading_zh": [
      "图中从上到下有四个英文说明框，圆圈在人体上标出例子。上框连向口与呼吸道附近，表示黏膜衬在与外界相通的管道内；这里展示的是位置，没有单独放大上皮与结缔组织的层次。",
      "第二框指向胸部与腹部，说明浆膜与胸膜腔、心包腔和腹膜腔等空间有关。第三框指向手表面，把皮肤称为皮膜；最下框指向膝部，说明滑膜衬在滑膜关节内面并参与形成滑液。",
      "四种膜的共同点是覆盖或衬里任务，组织组成却不全相同，滑膜不属于典型上皮膜。图中引线不是液体流动路线，也不表示所有黏膜都有同样分泌量；器官颜色仅用于区分位置。"
    ],
    "labels": [
      {
        "en": "Mucous membranes",
        "zh": "黏膜",
        "note": "最上方框指向口及呼吸道附近"
      },
      {
        "en": "Digestive, respiratory, urinary, and reproductive tracts",
        "zh": "消化道、呼吸道、泌尿道及生殖道",
        "note": "上框列举与外界相通的管道"
      },
      {
        "en": "Secretions of mucous glands",
        "zh": "黏液腺分泌物",
        "note": "上框说明黏膜表面可有黏液覆盖"
      },
      {
        "en": "Serous membranes",
        "zh": "浆膜",
        "note": "第二说明框指向胸腹部体腔界面"
      },
      {
        "en": "Peritoneal, pleural, and pericardial cavities",
        "zh": "腹膜腔、胸膜腔和心包腔",
        "note": "第二框列出相关浆膜腔隙名称"
      },
      {
        "en": "Cutaneous membrane, or the skin",
        "zh": "皮膜，即皮肤",
        "note": "第三框圈出手部的身体外表面"
      },
      {
        "en": "Synovial membranes",
        "zh": "滑膜",
        "note": "最下说明框圈出膝部关节位置"
      },
      {
        "en": "Joint cavities",
        "zh": "关节腔",
        "note": "最下框所述滑膜关节内部空间"
      },
      {
        "en": "Fluid within the joint",
        "zh": "关节内的滑液",
        "note": "最下框说明滑膜参与形成滑液"
      }
    ]
  },
  "03-01": {
    "reading_zh": [
      "先看右侧括号：最上方表皮覆盖表面，中部真皮含毛囊、腺体、神经和血管，更深处是有黄色脂肪团的皮下组织。皮下组织与皮肤紧密相接，但严格说不属于皮肤本体的第三层。",
      "沿一根毛向下，可见毛囊、毛根和周围神经丛；斜行红色束是立毛肌，旁边黄色分叶结构是皮脂腺。右侧卷曲小汗腺另有导管通向表面汗孔，并非借毛干排汗。",
      "再找深处同心层状的环层小体和底部血管丛。黄线表示神经，红蓝线表示血管，都是识别配色；图把多种结构集中并放大，不能按画面比例推算皮肤厚度、感受器大小或每处皮肤的配置。"
    ],
    "labels": [
      {
        "en": "Epidermis",
        "zh": "表皮",
        "note": "右侧最上括号所示无血管上皮层"
      },
      {
        "en": "Dermis",
        "zh": "真皮",
        "note": "右侧中部括号含纤维血管神经等"
      },
      {
        "en": "Hypodermis",
        "zh": "皮下组织",
