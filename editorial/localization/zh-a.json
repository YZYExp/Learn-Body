  },
  "03-02": {
    "reading_zh": [
      "顺着棕色毛干从表面向下，毛囊末端膨大形成毛球。右上括号把毛干拆成髓质、皮质和毛小皮三个同心部分；这些是毛发自身的组成，不能与包围毛根的根鞘混为一层。",
      "在毛根两侧辨认内根鞘与外根鞘，再看毛球底部的毛母质和毛乳头：前者参与产生毛发细胞，后者是伸入毛球的结缔组织结构，图中画有进入其内的血管。",
      "旁侧黄色分叶结构是皮脂腺，斜行红束是立毛肌。本图没有汗腺，不能把皮脂腺当作排汗结构；各层颜色与厚度经过示意化，毛乳头不是毛干最下面的一截，外根鞘也不只局限在毛球。"
    ],
    "labels": [
      {
        "en": "Hair shaft",
        "zh": "毛干",
        "note": "表面伸出的毛发并在图中局部剖开"
      },
      {
        "en": "Medulla",
        "zh": "毛髓质",
        "note": "毛干中心部分，部分毛发不明显"
      },
      {
        "en": "Cortex",
        "zh": "毛皮质",
        "note": "毛干中间主要角化结构区域"
      },
      {
        "en": "Cuticle",
        "zh": "毛小皮",
        "note": "毛干最外层薄的角化保护结构"
      },
      {
        "en": "Sebaceous gland",
        "zh": "皮脂腺",
        "note": "右侧分叶腺体把皮脂送入毛囊"
      },
      {
        "en": "Arrector pili muscle",
        "zh": "立毛肌",
        "note": "左侧斜行红色平滑肌牵连毛囊"
      },
      {
        "en": "Inner root sheath",
        "zh": "内根鞘",
        "note": "毛根周围靠内侧的鞘性结构"
      },
      {
        "en": "Outer root sheath",
        "zh": "外根鞘",
        "note": "内根鞘外方并与表皮连续的结构"
      },
      {
        "en": "Hair bulb",
        "zh": "毛球",
        "note": "毛囊最下端膨大的生长相关区域"
      },
      {
        "en": "Hair matrix",
        "zh": "毛母质",
        "note": "毛乳头周围增殖细胞参与毛发生长"
      },
      {
        "en": "Hair papilla",
        "zh": "毛乳头",
        "note": "毛球底部结缔组织突起含血管"
      }
    ]
  },
  "04-01": {
    "reading_zh": [
      "左侧是结缔组织构成示意，右侧是染色后的显微照片，二者不是同一视野的逐点复制。先在左图区分粗的胶原纤维、细的弹性纤维与上方网状纤维，再寻找其间的不同细胞。",
      "成纤维细胞参与形成基质，脂肪细胞储存脂滴，巨噬细胞参与防御与清除。图把多种细胞同时放在一个小框中，是为说明组成，不表示真实组织处处按此数量比例分布。",
      "右图箭头分别标出纤维细胞、间充质细胞和脂肪细胞。较空白的圆形区域常与脂肪细胞在制片中的表现有关，不能理解成活体组织内的大空洞；粉红与紫色来自染色，此图也不是全身筋膜的立体地图。"
    ],
    "labels": [
      {
        "en": "Reticular fibers",
        "zh": "网状纤维",
        "note": "左图上方细密分支网提供支持"
      },
      {
        "en": "Adipocytes",
        "zh": "脂肪细胞",
        "note": "左图黄色大细胞储存脂滴"
      },
      {
        "en": "Mesenchymal cell",
        "zh": "间充质细胞",
        "note": "左图细长突起细胞为组织成分示例"
      },
      {
        "en": "Elastic fibers",
        "zh": "弹性纤维",
        "note": "左图较细绿线有助组织伸展回弹"
      },
      {
        "en": "Collagen fibers",
        "zh": "胶原纤维",
        "note": "左图粗的浅色纤维参与承受拉力"
      },
      {
        "en": "Fibroblast",
        "zh": "成纤维细胞",
        "note": "左图中央较大细胞参与产生基质"
      },
      {
        "en": "Macrophage",
        "zh": "巨噬细胞",
        "note": "左图下方细胞参与吞噬与清除"
      },
      {
        "en": "fibrocyte",
        "zh": "纤维细胞",
        "note": "右图右上箭头标出较静息细胞"
      },
      {
        "en": "mesenchymal",
        "zh": "间充质细胞",
        "note": "右图左下箭头指向间充质细胞示例"
      },
      {
        "en": "adipocyte",
        "zh": "脂肪细胞",
        "note": "右图中央箭头指向脂肪细胞截面"
      }
    ]
  },
  "04-02": {
    "reading_zh": [
      "上排（a）为致密规则结缔组织，下排（b）为致密不规则结缔组织；每排左边是简图，右边是显微照片。先只比较纤维走向：上排胶原大体平行，下排胶原束朝多个方向交织。",
      "两排中深色细长小结构是成纤维细胞核，不是更多细小胶原纤维。规则排列适合沿主要方向传递拉力，不规则排列适应较复杂的方向性受力；“不规则”不是没有组织或杂乱失效。",
      "上排简图纵向、照片横向只是取景方向不同，不能据此认定结构相反。照片的粉红来自染色，放大倍数也不同；应比较局部排列关系，而非按画面粗细直接判定两种组织真实纤维尺寸。"
    ],
    "labels": [
      {
        "en": "(a) Regular dense",
        "zh": "（a）致密规则结缔组织",
        "note": "上排纤维大致平行排列的类型"
      },
      {
        "en": "(b) Irregular dense",
        "zh": "（b）致密不规则结缔组织",
        "note": "下排纤维束多方向交织的类型"
      },
      {
        "en": "Collagen fibers",
        "zh": "胶原纤维",
        "note": "上排指线定位平行走行的纤维"
      },
      {
        "en": "Fibroblast nuclei",
        "zh": "成纤维细胞核",
        "note": "两排深色细长细胞核位于纤维间"
      },
      {
        "en": "Collagen fiber bundles",
        "zh": "胶原纤维束",
        "note": "下排指线定位多方向的粗纤维束"
      }
    ]
  },
  "05-01": {
    "reading_zh": [
      "从最上方整块骨骼肌开始，先找包在整体外面的肌外膜，再看被抽出放大的肌束。灰色箭头表示逐级放大，并非肌肉收缩方向；肌束周围的结缔组织称肌束膜。",
      "中间把一个肌束再次放大，显示里面的多条肌纤维，每条外周有肌内膜。肌纤维其实是一条肌细胞；图右侧的卫星细胞贴近肌纤维表面，与肌纤维内的小圆结构并不是同一类成分。",
      "最下方继续放大一条肌纤维，肌膜围住细胞，内部平行排列许多肌原纤维。肌外膜、肌束膜、肌内膜是结缔组织层次，肌膜则是细胞膜；各级放大不同比例，不能把图中抽出的部分看作活体里游离的绳索。"
    ],
    "labels": [
      {
        "en": "Skeletal muscle",
        "zh": "骨骼肌",
        "note": "上方整块肌肉器官的外观示例"
      },
      {
        "en": "Epimysium",
        "zh": "肌外膜",
        "note": "围绕整块肌肉的结缔组织外层"
      },
      {
        "en": "Muscle fascicle",
        "zh": "肌束",
        "note": "多条肌纤维组成并被继续放大"
      },
      {
        "en": "Perimysium",
        "zh": "肌束膜",
        "note": "包围一束肌纤维的结缔组织层"
      },
      {
        "en": "Endomysium",
        "zh": "肌内膜",
        "note": "每条肌纤维外周的薄结缔组织"
      },
      {
        "en": "Muscle fiber",
        "zh": "肌纤维",
        "note": "中下图所示一条细长骨骼肌细胞"
      },
      {
        "en": "Satellite cell",
        "zh": "卫星细胞",
        "note": "肌纤维表面附近的修复相关细胞"
      },
      {
        "en": "Sarcolemma",
        "zh": "肌膜",
        "note": "围住肌纤维细胞的质膜结构"
      },
      {
        "en": "Myofibril",
        "zh": "肌原纤维",
        "note": "肌纤维内部平行细丝状收缩结构"
      }
    ]
  },
  "05-02": {
    "reading_zh": [
      "上图以两条Z线之间标出一个肌节。绿色细肌丝从两端向中央伸入，紫色粗肌丝居中；A带跨越粗肌丝全长，I带只有细肌丝，H带是中央不与细肌丝重叠的区域，M线位于中央。",
      "沿灰箭头向下，左边把粗肌丝放大成带许多头部的结构，右边显示细肌丝的肌动蛋白、原肌球蛋白和肌钙蛋白。再看最下方，肌球蛋白分子的头部同时具有与肌动蛋白、ATP结合的位点。",
      "这些位点与头部活动解释了肌丝如何相互作用。颜色只为区分蛋白，图中各层放大倍数不同；Z线不是细肌丝本身，粗肌丝也不是只有一个肌球蛋白分子，不能把分子图与整条肌丝等同。"
    ],
    "labels": [
      {
        "en": "Sarcomere",
        "zh": "肌节",
        "note": "相邻两条Z线之间的收缩结构单位"
      },
      {
        "en": "Z line",
        "zh": "Z线",
        "note": "肌节边界并锚定细肌丝的位置"
      },
      {
        "en": "H zone",
        "zh": "H带",
        "note": "肌节中央仅有粗肌丝的区域"
      },
      {
        "en": "M line",
        "zh": "M线",
        "note": "肌节中央联系粗肌丝的结构"
      },
      {
        "en": "Lighter I band",
        "zh": "较浅的I带（明带）",
        "note": "仅有细肌丝区域并跨越Z线"
      },
      {
        "en": "Darker A band",
        "zh": "较深的A带（暗带）",
        "note": "对应粗肌丝全长含重叠区域"
      },
      {
        "en": "Portion of a thick filament",
        "zh": "一段粗肌丝",
        "note": "中左放大结构由许多肌球蛋白组成"
      },
      {
        "en": "Portion of a thin filament",
        "zh": "一段细肌丝",
        "note": "中右放大结构含肌动及调节蛋白"
      },
      {
        "en": "Head",
        "zh": "头部",
        "note": "粗肌丝上突出的肌球蛋白头部"
      },
      {
        "en": "Troponin",
        "zh": "肌钙蛋白",
        "note": "细肌丝上参与钙调节的蛋白复合物"
      },
      {
        "en": "Actin",
        "zh": "肌动蛋白",
        "note": "绿色珠状结构组成细肌丝骨架"
      },
      {
        "en": "Tropomyosin",
        "zh": "原肌球蛋白",
        "note": "沿肌动蛋白延伸的长链调节蛋白"
      },
      {
        "en": "Actin-binding sites",
        "zh": "肌动蛋白结合位点",
        "note": "下左肌球蛋白头与细肌丝作用处"
      },
      {
        "en": "ATP-binding site",
        "zh": "ATP结合位点",
        "note": "肌球蛋白头利用ATP相关能量变化"
      },
      {
        "en": "Tail",
        "zh": "尾部",
        "note": "肌球蛋白分子较长的杆状部分"
      },
      {
        "en": "Heads",
        "zh": "头部",
        "note": "一分子肌球蛋白的两个球状头"
      },
      {
        "en": "Myosin molecule",
        "zh": "肌球蛋白分子",
        "note": "下左显示双头和长尾的单个分子"
      },
      {
        "en": "Flexible hinge region",
        "zh": "可屈曲铰链区",
        "note": "肌球蛋白头尾连接附近的活动区"
      },
      {
        "en": "Binding site for myosin",
        "zh": "肌球蛋白结合位点",
        "note": "下右肌动蛋白上与肌球蛋白相接处"
      },
      {
        "en": "Actin subunits",
        "zh": "肌动蛋白亚基",
        "note": "下右一颗颗绿色单位构成肌动蛋白链"
      }
    ]
  },
  "05-03": {
    "reading_zh": [
      "上下两图比较同一类肌节在较长和缩短状态下的排列。先固定中央M线，再找到左右Z线：下图两端Z线靠近，黑色大箭头提示两端向内的相对移动，表示肌节整体缩短。",
      "绿色细肌丝由两侧向中央滑入，紫色粗肌丝长度保持不变，两者重叠增加。对比底部括号可见I带缩小，中央H带也变窄，而对应粗肌丝全长的A带宽度基本不变。",
      "下图画出肌球蛋白头与细肌丝接触的关系，强调滑行而非肌丝自身缩短。绿色和紫色是蛋白识别色，黑箭头不是外力必须从外侧推压肌肉，也不表示所有收缩都必然让整块肌肉缩短。"
    ],
    "labels": [
      {
        "en": "Z",
        "zh": "Z线",
        "note": "左右肌节边界随图示缩短相互靠近"
      },
      {
        "en": "M",
        "zh": "M线",
        "note": "中央标记便于比较粗肌丝的位置"
      },
      {
        "en": "H",
        "zh": "H带",
        "note": "中央仅有粗肌丝的区域缩小时变窄"
      },
      {
        "en": "Lighter I band",
        "zh": "较浅的I带（明带）",
        "note": "两侧仅有细肌丝的区域在下图缩小"
      },
      {
        "en": "Darker A band",
        "zh": "较深的A带（暗带）",
        "note": "粗肌丝对应区域在两图宽度基本相同"
      }
    ]
  },
  "06-01": {
    "reading_zh": [
      "左边是前面观，右边是后面观，先用右下图例分组：米灰色中轴骨骼包括颅骨、脊柱和胸廓，浅绿色附肢骨骼包括肩带、骨盆带及四肢。蓝色关节区域只是辅助显示，不属于第三类骨骼。",
      "沿上肢从锁骨和肩胛骨到肱骨，再到尺桡骨、腕骨、掌骨和指骨；前面观手掌朝前，桡骨在拇指侧。沿下肢从髋骨到股骨，再看髌骨、胫腓骨、跗骨、跖骨和趾骨。",
      "两图共同显示被前方遮住的肩胛骨与脊柱关系，不能把前后图当成两套不同骨架。特别注意骶骨属于中轴骨骼，而两侧髋骨属于骨盆带；分组颜色说明连接归属，不是骨头的自然颜色。"
    ],
    "labels": [
      {
        "en": "Anterior view",
        "zh": "前面观",
        "note": "左侧骨架从身体正前方观察"
      },
      {
        "en": "Posterior view",
        "zh": "后面观",
        "note": "右侧骨架从身体正后方观察"
      },
      {
        "en": "Key",
        "zh": "图例",
        "note": "右下方颜色说明骨骼分组归属"
      },
      {
        "en": "Axial skeleton",
        "zh": "中轴骨骼",
        "note": "米灰色标示颅骨脊柱及胸廓"
      },
      {
        "en": "Appendicular skeleton",
        "zh": "附肢骨骼",
        "note": "浅绿色标示肢带和四肢骨骼"
      },
      {
        "en": "Skull",
        "zh": "颅骨",
        "note": "顶部总称脑颅与面颅的骨性结构"
      },
      {
        "en": "Cranial portion",
        "zh": "脑颅部分",
        "note": "颅骨上后部围护脑的骨性结构"
      },
      {
        "en": "Facial portion",
        "zh": "面颅部分",
        "note": "颅骨前下部构成面部的骨性结构"
      },
      {
