  "21-02": {
    "reading_zh": [
      "沿图下方括号先把耳分成外耳、中耳、内耳，再从左侧耳廓向右沿外耳道找到鼓膜。鼓膜把外耳道与含气的中耳鼓室隔开，不应把整条通道都看成通向内耳的空管。",
      "继续追到与鼓膜相接的锤骨，再到砧骨与镫骨；镫骨底部接在卵圆窗，把振动传向内耳。耳蜗像盘绕的小壳，与上方前庭相邻；耳蜗神经与前庭神经传送的信息不同。",
      "右下斜向下方的咽鼓管连接鼓室与鼻咽部，参与压力平衡，不通入脑内。圆窗位于耳蜗邻近的骨壁，和镫骨所接的卵圆窗是两个不同的膜性窗口，不能混为同一出口。"
    ],
    "labels": [
      {
        "en": "Auricle",
        "zh": "耳廓",
        "note": "外侧可见并帮助收集声音的部分"
      },
      {
        "en": "Ear canal",
        "zh": "外耳道",
        "note": "将声音从耳廓附近传向鼓膜的通道"
      },
      {
        "en": "Tympanic membrane",
        "zh": "鼓膜",
        "note": "外耳道内端随声音振动的薄膜"
      },
      {
        "en": "Malleus",
        "zh": "锤骨",
        "note": "与鼓膜相连的第一块听小骨"
      },
      {
        "en": "Incus",
        "zh": "砧骨",
        "note": "位于锤骨与镫骨之间的听小骨"
      },
      {
        "en": "Stapes (attached to oval window)",
        "zh": "镫骨（连接卵圆窗）",
        "note": "其底部将听小骨振动传向内耳"
      },
      {
        "en": "Tympanic cavity",
        "zh": "鼓室",
        "note": "位于鼓膜内侧并容纳听小骨的含气腔"
      },
      {
        "en": "Vestibule",
        "zh": "前庭",
        "note": "内耳中连接半规管与耳蜗邻近的区域"
      },
      {
        "en": "Vestibular nerve",
        "zh": "前庭神经",
        "note": "传送与头位和运动相关的平衡信息"
      },
      {
        "en": "Cochlear nerve",
        "zh": "耳蜗神经",
        "note": "将耳蜗产生的听觉信息传向中枢"
      },
      {
        "en": "Round window",
        "zh": "圆窗",
        "note": "耳蜗邻近由膜封闭的另一窗口"
      },
      {
        "en": "Cochlea",
        "zh": "耳蜗",
        "note": "内耳中盘绕并完成听觉转换的结构"
      },
      {
        "en": "Eustachian tube",
        "zh": "咽鼓管",
        "note": "连接鼓室与鼻咽部以帮助平衡压力"
      },
      {
        "en": "External ear",
        "zh": "外耳",
        "note": "图下左侧括号划定耳廓到鼓膜的部分"
      },
      {
        "en": "Middle ear",
        "zh": "中耳",
        "note": "图下中部括号包含鼓室与听小骨"
      },
      {
        "en": "Inner ear",
        "zh": "内耳",
        "note": "图下右侧括号包含耳蜗与前庭结构"
      }
    ]
  },
  "21-03": {
    "reading_zh": [
      "先看左上鼻腔侧面图，红箭头是吸入气流，嗅上皮只位于鼻腔顶部的一小片区域。灰色大箭头将这个局部放大到右图，既不是气流，也不是神经信号的传播方向。",
      "右图由下向上读：气味分子随气流到达黏液，接触嗅纤毛及嗅觉感受神经元。它们的轴突汇成嗅神经细丝，穿过筛骨筛板小孔，在嗅球内与后续神经元建立联系，之后接入嗅束。",
      "右图的嗅腺与结缔组织位于上皮的深面，不能把嗅腺当成感受神经元。最下方是染色嗅上皮的显微照片，对照模式图找排列密集的细胞层；原材料来自动物组织，并非人体鼻腔实拍。"
    ],
    "labels": [
      {
        "en": "Olfactory bulb",
        "zh": "嗅球",
        "note": "位于鼻腔顶部骨板上方的嗅觉中继结构"
      },
      {
        "en": "Olfactory tract",
        "zh": "嗅束",
        "note": "由嗅球向后联系其他脑区的纤维通路"
      },
      {
        "en": "Olfactory epithelium",
        "zh": "嗅上皮",
        "note": "鼻腔上部含嗅觉感受神经元的上皮"
      },
      {
        "en": "Nasal conchae",
        "zh": "鼻甲",
        "note": "鼻腔侧壁向内突出的卷曲骨性结构"
      },
      {
        "en": "Path of inhaled air",
        "zh": "吸入空气的路径",
        "note": "左图红箭头表示空气进入鼻腔方向"
      },
      {
        "en": "Mitral cells",
        "zh": "僧帽细胞",
        "note": "嗅球内接收输入并参与输出的神经元"
      },
      {
        "en": "Olfactory neurons",
        "zh": "嗅觉神经元",
        "note": "原图引线指向嗅球下部的轴突汇聚区"
      },
      {
        "en": "Ethmoid bone",
        "zh": "筛骨",
        "note": "图中多孔骨板属于筛骨的筛板部分"
      },
      {
        "en": "Filaments of olfactory nerve",
        "zh": "嗅神经细丝",
        "note": "嗅觉感受神经元轴突穿筛板形成的细束"
      },
      {
        "en": "Connective tissue",
        "zh": "结缔组织",
        "note": "位于嗅上皮深面并支持血管和腺体"
      },
      {
        "en": "Olfactory gland",
        "zh": "嗅腺",
        "note": "位于上皮深面并向表面分泌的腺体"
      },
      {
        "en": "Olfactory receptor",
        "zh": "嗅觉感受神经元",
        "note": "黄色细长细胞负责感受气味刺激"
      },
      {
        "en": "Dendrite",
        "zh": "树突",
        "note": "从感受神经元胞体伸向表面的突起"
      },
      {
        "en": "Mucus",
        "zh": "黏液",
        "note": "覆盖嗅上皮表面并溶解气味分子"
      },
      {
        "en": "Olfactory cilia",
        "zh": "嗅纤毛",
        "note": "位于上皮表面黏液中并承载感受结构"
      },
      {
        "en": "Path of inhaled air containing odorant molecules",
        "zh": "含气味分子的吸入气流路径",
        "note": "右图底部红箭头表示气流经过上皮表面"
      },
      {
        "en": "Nasal cavity",
        "zh": "鼻腔",
        "note": "左侧分图显示嗅觉区域的整体位置"
      },
      {
        "en": "Olfactory system",
        "zh": "嗅觉系统",
        "note": "右侧分图显示从上皮到嗅球的局部连接"
      }
    ]
  },
  "22-01": {
    "reading_zh": [
      "先从左侧人体轮廓由上向下定位：头部下丘脑、垂体和松果体，颈部甲状腺及甲状旁腺，上胸部胸腺，再到腹部肾上腺和胰腺。图省略了很多邻近器官，并不是完整解剖剖面。",
      "两支灰色大箭头仅表示局部放大。头部框用于分清松果体、下丘脑和垂体；颈部框把通常位于甲状腺后侧的甲状旁腺透出显示，四个小点不表示它们都能从正面直接看见。",
      "下方把卵巢和睾丸两类性腺并置于同一轮廓内以便比较，并非一名个体的实际器官组合。子宫、气管与甲状软骨是位置参照，不能因被标出就把它们等同于图中独立内分泌腺。"
    ],
    "labels": [
      {
        "en": "Pineal gland",
        "zh": "松果体",
        "note": "位于间脑后上部并产生褪黑素的结构"
      },
      {
        "en": "Hypothalamus",
        "zh": "下丘脑",
        "note": "位于间脑下部并联系神经与内分泌调节"
      },
      {
        "en": "Pituitary gland",
        "zh": "垂体",
        "note": "位于下丘脑下方并由垂体柄相连"
      },
      {
        "en": "Thymus",
        "zh": "胸腺",
        "note": "位于胸腔前上部的免疫相关器官"
      },
      {
        "en": "Thyroid",
        "zh": "甲状腺局部图",
        "note": "右中放大框展示甲状腺邻近结构"
      },
      {
        "en": "Thyroid cartilage of the larynx",
        "zh": "喉的甲状软骨",
        "note": "位于甲状腺上方的喉部软骨参照"
      },
      {
        "en": "Thyroid gland",
        "zh": "甲状腺",
        "note": "位于颈前并分列气管上段两侧"
