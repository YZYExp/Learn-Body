      },
      {
        "en": "Uterus",
        "zh": "子宫",
        "note": "此处作为卵巢位置关系的盆腔参照"
      },
      {
        "en": "Ovaries (female)",
        "zh": "卵巢（女性常见性腺）",
        "note": "位于子宫两侧并兼具生殖与内分泌作用"
