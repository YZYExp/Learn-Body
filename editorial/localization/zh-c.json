      {
        "en": "Liver",
        "zh": "肝",
        "note": "腹部画面左上的大器官，产生胆汁"
      },
      {
        "en": "Gallbladder",
        "zh": "胆囊",
        "note": "肝下绿色小囊，储存并浓缩胆汁"
