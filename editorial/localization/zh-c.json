  "16-01": {
    "reading_zh": [
      "从左上食管进入贲门，先认右上隆起的胃底和右侧较大的胃体，再沿下部胃窦、幽门管找到左侧十二指肠。图把胃壁局部翻开，才同时看到肌层和胃腔。",
      "左上三条引线分别指出纵行、环行、斜行肌层；斜行肌束是胃壁搅拌能力的一项结构基础。右侧最外面薄层为浆膜，胃腔内的起伏则是黏膜皱襞，不是同一层肌束。",
      "靠幽门出口的环形增厚为幽门括约肌，参与控制排空。胃大弯和小弯旁的黑色双向弧箭头只标示两条弯曲边缘的范围，不表示食物沿胃外缘来回流动。"
    ],
    "labels": [
      {
        "en": "Esophagus",
        "zh": "食管",
        "note": "左上管道，经贲门将食物送入胃"
      },
      {
        "en": "Muscularis externa:",
        "zh": "肌层",
        "note": "图中被翻开显示的平滑肌层总称"
      },
      {
        "en": "Longitudinal layer",
        "zh": "纵行肌层",
        "note": "肌层外部，肌束大体沿胃长轴走行"
      },
      {
        "en": "Circular layer",
        "zh": "环行肌层",
        "note": "肌层中间，肌束环绕胃腔方向排列"
      },
      {
        "en": "Oblique layer",
        "zh": "斜行肌层",
        "note": "胃的内侧斜行肌束，帮助混合内容物"
      },
      {
        "en": "Cardia",
        "zh": "贲门部",
        "note": "食管接入胃的入口附近区域名称"
      },
      {
        "en": "Fundus",
        "zh": "胃底",
        "note": "画面右上方穹隆状隆起，邻近膈下"
      },
      {
        "en": "Body",
        "zh": "胃体",
        "note": "图中胃的主要中部，大括号标出范围"
      },
      {
        "en": "Serosa",
        "zh": "浆膜",
        "note": "胃壁最外表面的薄层，与腹膜相关"
      },
      {
        "en": "Lumen",
        "zh": "胃腔",
        "note": "容纳胃内容物的内部空间，不是胃壁"
      },
      {
        "en": "Rugae of mucosa",
        "zh": "胃黏膜皱襞（胃襞）",
        "note": "胃腔面的起伏，可随充盈而展开"
      },
      {
        "en": "Lesser curvature",
        "zh": "胃小弯",
        "note": "画面左侧凹入边缘，弧箭头标示范围"
      },
      {
        "en": "Greater curvature",
        "zh": "胃大弯",
        "note": "画面右下凸出长边缘，弧箭头标范围"
      },
      {
        "en": "Pyloric antrum",
        "zh": "幽门窦",
        "note": "靠出口较宽的区域，向幽门管过渡"
      },
      {
        "en": "Pyloric canal",
        "zh": "幽门管",
        "note": "幽门窦之后较窄部分，通向出口"
      },
      {
        "en": "Pyloric sphincter (valve) at pylorus",
        "zh": "幽门处的幽门括约肌",
        "note": "出口环形增厚平滑肌，帮助控制排空"
      },
      {
        "en": "Duodenum",
        "zh": "十二指肠",
        "note": "图中左下离开胃的管道，接幽门"
      }
    ]
  },
  "16-02": {
    "reading_zh": [
      "先找棕红色肝、绿色胆囊和下方黄色胰，紫色脾在画面右侧。人体右侧在画面左边；背景身体和其他消化器官被淡化，是为显露这些深部器官，并不表示它们悬在空处。",
      "沿肝的绿色导管读：左右肝管汇成肝总管，胆囊经胆囊管接入，合并后的通路称胆总管。胆汁由肝产生，胆囊负责储存和浓缩；引线指出位置，不是表示流向的箭头。",
      "再看胰内的胰管，它把外分泌胰液引向十二指肠。肝分叶名称用于辨认形态，不能当成四个独立器官；脾作为邻近结构一并显示，却不向肠道分泌消化液。"
    ],
    "labels": [
      {
        "en": "Liver:",
        "zh": "肝",
        "note": "上方棕红色大器官，图中标出形态分叶"
      },
      {
        "en": "Right lobe",
        "zh": "肝右叶",
        "note": "画面左侧较大部分，属于人体右侧"
      },
      {
        "en": "Quadrate lobe",
        "zh": "肝方叶",
        "note": "肝脏面上的分叶，图为显露而简化"
      },
      {
        "en": "Left lobe",
        "zh": "肝左叶",
        "note": "画面右上较薄延伸部分，按引线辨认"
      },
      {
        "en": "Caudate lobe",
        "zh": "肝尾状叶",
        "note": "肝后方相关分叶，并非尾部额外器官"
      },
      {
        "en": "Gallbladder",
        "zh": "胆囊",
        "note": "肝下方绿色小囊，储存并浓缩胆汁"
      },
      {
        "en": "Right hepatic duct",
        "zh": "右肝管",
        "note": "汇集肝右侧胆汁，与左肝管相接"
      },
      {
        "en": "Left hepatic duct",
        "zh": "左肝管",
        "note": "汇集肝左侧胆汁，汇向共同胆道"
      },
      {
        "en": "Common hepatic duct",
        "zh": "肝总管",
        "note": "左右肝管汇合后的一段胆汁通道"
      },
      {
        "en": "Cystic duct",
        "zh": "胆囊管",
        "note": "连接胆囊与肝外胆道的绿色短管"
      },
      {
        "en": "Common bile duct",
        "zh": "胆总管",
        "note": "肝总管与胆囊管汇合后的下行胆道"
      },
      {
        "en": "Spleen",
        "zh": "脾",
        "note": "画面右方紫色器官，不分泌消化液"
      },
      {
        "en": "Pancreas",
        "zh": "胰腺",
        "note": "肝下黄色横向腺体，兼具两类分泌"
      },
      {
        "en": "Pancreatic duct",
        "zh": "胰管",
        "note": "胰内部细管，输送外分泌胰液入肠"
      }
    ]
  },
  "17-01": {
    "reading_zh": [
      "左上小框先交代两肾在上腹后部的位置，右侧大图展开左肾。先由最外薄囊进入皮质，再认内部放射状肾锥体及锥体间的肾柱；肾髓质主要包括这些锥体区域。",
      "沿淡黄色尿路，从锥体尖端的肾乳头进入肾小盏，汇入肾大盏、肾盂，再向下到输尿管。这是尿液汇集方向，不是红蓝血液从肾门进入后直接流走的路线。",
      "最后读红蓝血管：叶间血管走在锥体之间，弓状血管绕锥体底部，再分到皮质。黄色实心分支是神经，肾门是这些结构出入的区域；三者即使靠近，也不是同一管腔。"
    ],
    "labels": [
      {
        "en": "Capsule",
        "zh": "肾纤维囊",
        "note": "紧贴肾表面的薄被膜，包绕肾组织"
      },
      {
        "en": "Cortex",
        "zh": "肾皮质",
        "note": "外周较均匀区域，位于髓质外侧"
      },
      {
        "en": "Medulla",
        "zh": "肾髓质",
        "note": "内部包含多个肾锥体的组织区域"
      },
      {
        "en": "Pyramid",
        "zh": "肾锥体",
        "note": "髓质内放射状三角形区域，尖端朝肾窦"
      },
      {
        "en": "Papilla",
        "zh": "肾乳头",
        "note": "肾锥体尖端，尿液从此流入肾小盏"
      },
      {
        "en": "Renal column",
        "zh": "肾柱",
        "note": "锥体之间延伸进入深部的皮质组织"
      },
      {
        "en": "Minor calyx",
        "zh": "肾小盏",
        "note": "包接肾乳头的较小尿液收集结构"
      },
      {
        "en": "Major calyx",
        "zh": "肾大盏",
        "note": "由多个肾小盏汇合形成的较大通路"
      },
      {
        "en": "Renal pelvis",
        "zh": "肾盂",
        "note": "肾中央漏斗形汇集部，向输尿管延续"
      },
      {
        "en": "Ureter",
        "zh": "输尿管",
        "note": "图中向下延伸的尿液运输管道"
      },
      {
        "en": "Renal hilum",
        "zh": "肾门",
        "note": "内侧凹入处，血管神经及尿路出入"
      },
      {
        "en": "Renal artery",
        "zh": "肾动脉",
        "note": "红色入肾血管，向肾内逐级分支"
      },
      {
        "en": "Renal vein",
        "zh": "肾静脉",
        "note": "蓝色出肾血管，汇集肾内回流血液"
      },
      {
        "en": "Renal nerve",
        "zh": "肾神经",
        "note": "黄色实心分支，参与肾脏神经调节"
      },
      {
        "en": "Interlobar blood vessels",
        "zh": "叶间血管",
        "note": "走在肾锥体之间的血管，沿肾柱分布"
      },
      {
        "en": "Arcuate blood vessels",
        "zh": "弓状血管",
        "note": "在锥体底部附近弯行的红蓝血管"
      },
      {
        "en": "Cortical blood vessels",
        "zh": "皮质血管",
        "note": "分布在肾外周皮质中的细小血管"
      }
    ]
  },
  "17-02": {
    "reading_zh": [
      "先分清两套通路：红蓝细管是血管，淡黄色粗一些的管道是肾小管及集合系统。左上杯状肾小囊包住一团肾小球毛细血管；不要把整只杯子与杯内血管混为一物。",
      "血流由左侧皮质辐射动脉分支，经入球小动脉进入肾小球，再经出球小动脉去周围毛细血管网，最终汇入微静脉和蓝色皮质辐射静脉。血管引线并非血流方向箭头。",
      "小管液则从肾小囊走向近端曲小管，经过向下弯回的肾单位袢和后续管段，进入右侧未标名的集合管。底部黑箭头明确表示尿液流向肾乳头；血液不会直接流进这根黄色管。"
    ],
    "labels": [
      {
        "en": "Glomerular capsule",
        "zh": "肾小囊（鲍曼囊）",
        "note": "左上杯状结构，包围肾小球并接收滤液"
      },
      {
        "en": "Afferent arteriole",
        "zh": "入球小动脉",
        "note": "从左侧动脉进入肾小球的供血分支"
      },
      {
        "en": "Efferent arteriole",
        "zh": "出球小动脉",
        "note": "离开肾小球后接续另一毛细血管网"
      },
      {
        "en": "Proximal convoluted tubule",
        "zh": "近端曲小管",
        "note": "肾小囊之后弯曲黄色管段，回收多种物质"
      },
      {
        "en": "Cortical radiate artery",
        "zh": "皮质辐射动脉",
        "note": "左侧红色主干，发出肾小球供血分支"
      },
      {
        "en": "Cortical radiate vein",
        "zh": "皮质辐射静脉",
        "note": "左侧蓝色主干，汇集周围微静脉血液"
      },
      {
        "en": "Venule",
        "zh": "微静脉",
        "note": "连接毛细血管网与蓝色较大静脉"
      },
      {
        "en": "Loop of the nephron",
        "zh": "肾单位袢（亨利袢）",
        "note": "淡黄色向下后折返的细长小管段"
      },
      {
        "en": "Peritubular capillary network",
        "zh": "肾小管周围毛细血管网",
        "note": "围绕黄色小管的细血管，参与物质交换"
      },
      {
        "en": "Urine flows into renal papilla",
        "zh": "尿液流向肾乳头",
        "note": "底部黑箭头，指集合系统中尿液去向"
      }
    ]
  },
  "18-01": {
    "reading_zh": [
      "上方a、b只比较包皮保留与环切后的外观，灰色箭头表示局部放大。先认阴茎、龟头和阴囊，别把外观分图当成展示盆腔内部的切面，也不要把阴囊误称睾丸本身。",
      "下方c为侧面剖开示意：画面左为前、右为后。先以耻骨联合定位，再找其后的膀胱、膀胱下方前列腺和更后方直肠区域，尿道依次穿过前列腺、会阴和阴茎。",
      "生殖通路从阴囊内睾丸、附睾进入输精管，绕向膀胱后方，与精囊导管汇合后经射精管接入尿道。尿道旁海绵体是组织，不是额外空管；两处阴茎外观也不代表两种内部器官配置。"
    ],
    "labels": [
      {
