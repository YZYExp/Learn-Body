{
  "13-01": {
    "reading_zh": [
      "先看下半幅的全身图：这是正面示意，人体右侧在画面左侧。沿蓝色静脉进入右心，再到两肺；红色血液回到左心后，经上下两路进入全身毛细血管，最后返回右心。",
      "再看上方放大的心脏。依白箭头从右心房、三尖瓣到右心室，经肺动脉瓣进入肺动脉干；肺静脉带血回左心房，再经二尖瓣进入左心室，经主动脉瓣离开心脏。",
      "肺循环与体循环串联，不能把两幅图看成两套独立血液。红蓝表示含氧相对高低，蓝色不是血液真色；肺动脉虽画蓝色，仍因离开心脏而称动脉。灰色大箭头只表示放大对应。"
    ],
    "labels": [
      {
        "en": "Superior vena cava",
        "zh": "上腔静脉",
        "note": "上方蓝色大血管，将血送回右心房"
      },
      {
        "en": "Inferior vena cava",
        "zh": "下腔静脉",
        "note": "下方蓝色大血管，接收下部回流血液"
      },
      {
        "en": "Right atrium",
        "zh": "右心房",
        "note": "画面左侧上腔室，接收体循环回流"
      },
      {
        "en": "Right ventricle",
        "zh": "右心室",
        "note": "画面左侧下腔室，将血泵向肺循环"
      },
      {
        "en": "Tricuspid valve",
        "zh": "三尖瓣",
        "note": "位于右心房与右心室之间的瓣膜"
      },
      {
        "en": "Pulmonary semilunar valve",
        "zh": "肺动脉瓣",
        "note": "右心室流出端的半月瓣，限制倒流"
      },
      {
        "en": "Pulmonary trunk",
        "zh": "肺动脉干",
        "note": "离开右心室后分向左右肺的血管"
      },
      {
        "en": "Right pulmonary arteries",
        "zh": "右肺动脉分支",
        "note": "伸向画面左边，把血带往人体右肺"
      },
      {
        "en": "Left pulmonary arteries",
        "zh": "左肺动脉分支",
        "note": "伸向画面右边，把血带往人体左肺"
      },
      {
        "en": "Right pulmonary veins",
        "zh": "右肺静脉",
        "note": "来自人体右肺，含氧血流向左心房"
      },
      {
        "en": "Left pulmonary veins",
        "zh": "左肺静脉",
        "note": "来自人体左肺，含氧血流向左心房"
      },
      {
        "en": "Left atrium",
        "zh": "左心房",
        "note": "画面右侧上腔室，接收肺静脉血液"
      },
      {
        "en": "Mitral valve",
        "zh": "二尖瓣",
        "note": "位于左心房与左心室之间的瓣膜"
      },
      {
        "en": "Left ventricle",
        "zh": "左心室",
        "note": "画面右侧下腔室，将血泵向体循环"
      },
      {
        "en": "Aortic semilunar valve",
        "zh": "主动脉瓣",
        "note": "左心室接主动脉处的半月形瓣膜"
      },
      {
        "en": "Aorta",
        "zh": "主动脉",
        "note": "上方红色弓形大血管，通向全身"
      },
      {
        "en": "Systemic arteries to upper body",
        "zh": "通往身体上部的体循环动脉",
        "note": "下图向头颈及上肢方向送血的红管"
      },
      {
        "en": "Systemic capillaries of upper body",
        "zh": "身体上部的体循环毛细血管",
        "note": "下图头颈区域交换物质的血管网"
      },
      {
        "en": "Systemic veins from upper body",
        "zh": "来自身体上部的体循环静脉",
        "note": "下图头颈区域向右心回流的蓝管"
      },
      {
        "en": "Pulmonary capillaries in lungs",
        "zh": "肺内毛细血管",
        "note": "下图两肺中的血管网，参与气体交换"
      },
      {
        "en": "Systemic arteries to lower body",
        "zh": "通往身体下部的体循环动脉",
        "note": "下图向腹部及下肢方向送血的红管"
      },
      {
        "en": "Systemic capillaries of lower body",
        "zh": "身体下部的体循环毛细血管",
        "note": "下图最下方发生组织交换的血管网"
      },
      {
        "en": "Systemic veins from lower body",
        "zh": "来自身体下部的体循环静脉",
        "note": "下图由身体下部向右心回流的蓝管"
      }
    ]
  },
  "13-02": {
    "reading_zh": [
      "这是一幅从前方观看、切去部分前壁的心脏图，并非三张不同照片。人体右心在画面左边，左心在右边；先找上方两心房、下方两心室，再看中间较厚的室间隔。",
      "沿房室之间的白色瓣叶向下，能找到腱索和乳头肌。它们帮助瓣叶在心室收缩时保持位置，并不负责把瓣膜拉开；右侧三尖瓣与左侧二尖瓣需分别认读。",
      "随后找上方主动脉与蓝色肺动脉干的出口，辨认两处半月瓣。最后看画面右下的心壁，从外到内依次为心外膜、心肌层与心内膜；心室内起伏的肉柱不应当作额外隔墙。"
    ],
    "labels": [
      {
        "en": "Anterior view",
        "zh": "前面观",
        "note": "表示从人体前方观察，左右需反转"
      },
      {
        "en": "Aorta",
        "zh": "主动脉",
        "note": "上方红色弓形血管，离开左心室"
      },
      {
        "en": "Superior vena cava",
        "zh": "上腔静脉",
        "note": "画面左上蓝色大管，进入右心房"
      },
      {
        "en": "Inferior vena cava",
        "zh": "下腔静脉",
        "note": "画面左下蓝色大管，进入右心房"
      },
      {
        "en": "Right pulmonary artery",
        "zh": "右肺动脉",
        "note": "画面左上横行分支，通往人体右肺"
      },
      {
        "en": "Left pulmonary artery",
        "zh": "左肺动脉",
        "note": "画面右上蓝色分支，通往人体左肺"
      },
      {
        "en": "Pulmonary trunk",
        "zh": "肺动脉干",
        "note": "上方中央蓝色血管，连接右心室出口"
      },
      {
        "en": "Right pulmonary veins",
        "zh": "右肺静脉",
        "note": "人体右肺回流血管，图中从左方进入"
      },
      {
        "en": "Left pulmonary veins",
        "zh": "左肺静脉",
        "note": "画面右上红色短管，回流至左心房"
      },
      {
        "en": "Right atrium",
        "zh": "右心房",
        "note": "画面左上的腔室，汇集体循环回流"
      },
      {
        "en": "Left atrium",
        "zh": "左心房",
        "note": "画面右上的腔室，接收来自肺的血液"
      },
      {
        "en": "Fossa ovalis",
        "zh": "卵圆窝",
        "note": "房间隔右房面上的凹陷，为胎儿通道遗迹"
      },
      {
        "en": "Tricuspid valve",
        "zh": "三尖瓣",
        "note": "右心房与右心室之间的房室瓣膜"
      },
      {
        "en": "Mitral (bicuspid) valve",
        "zh": "二尖瓣（左房室瓣）",
        "note": "左心房与左心室之间的房室瓣膜"
      },
      {
        "en": "Aortic valve",
        "zh": "主动脉瓣",
        "note": "左心室流入主动脉前经过的半月瓣"
      },
      {
        "en": "Pulmonary valve",
        "zh": "肺动脉瓣",
        "note": "右心室接肺动脉干处的半月瓣膜"
      },
      {
        "en": "Right ventricle",
        "zh": "右心室",
        "note": "画面左下腔室，与肺循环出口相连"
      },
      {
        "en": "Left ventricle",
        "zh": "左心室",
        "note": "画面右下腔室，肌壁较右心室厚"
      },
      {
        "en": "Chordae tendineae",
        "zh": "腱索",
        "note": "连接房室瓣叶与乳头肌的白色细索"
      },
      {
        "en": "Papillary muscle",
        "zh": "乳头肌",
        "note": "心室壁突起，收缩时帮助拉紧腱索"
      },
      {
        "en": "Trabeculae carneae",
        "zh": "肉柱",
        "note": "心室内壁的肌性起伏，并非腱索"
      },
      {
        "en": "Moderator band",
        "zh": "节制索（隔缘肉柱）",
        "note": "横跨右心室的肌束，传导纤维经此"
      },
      {
        "en": "Interventricular septum",
        "zh": "室间隔",
        "note": "中央分隔左右心室的肌性组织壁"
      },
      {
        "en": "Epicardium",
        "zh": "心外膜",
        "note": "心壁最外侧，也属于浆膜心包脏层"
      },
      {
        "en": "Myocardium",
        "zh": "心肌层",
        "note": "心壁中主要产生收缩力的厚肌层"
      },
      {
        "en": "Endocardium",
        "zh": "心内膜",
        "note": "贴衬心腔内面并覆盖相关结构的薄层"
      }
    ]
  },
  "14-01": {
    "reading_zh": [
      "上方左图为动脉，右图为静脉，下面是两者的组织切片；这张图没有毛细血管分图。先从白色管腔一侧向外看，依次辨认内膜、中膜、外膜，再比较动脉较厚的中膜。",
      "动脉图中的波浪线是弹性膜，细小交错丝线表示弹性纤维；红色细长细胞是平滑肌。管壁内另有滋养血管与神经，它们服务于血管壁，并非大管腔内的血液分支。",
      "最后看下方切片：动脉较圆、壁厚，静脉管腔较不规则且有塌陷。这是本次切片的形态，不能把圆扁作为唯一鉴别标准；还须一起比较管壁层次与相对厚度。"
    ],
    "labels": [
      {
        "en": "Artery",
        "zh": "动脉",
        "note": "上方左图及下方圆形较厚壁血管"
      },
      {
        "en": "Vein",
        "zh": "静脉",
        "note": "上方右图及下方较扁不规则血管"
      },
      {
        "en": "Tunica intima",
        "zh": "内膜",
        "note": "面向管腔的一层，包含内皮等结构"
      },
      {
        "en": "Tunica media",
        "zh": "中膜",
        "note": "内外膜之间，平滑肌及弹性成分较多"
      },
      {
        "en": "Tunica externa",
        "zh": "外膜",
        "note": "最外侧结缔组织层，与周围组织相连"
      },
      {
        "en": "Smooth muscle",
        "zh": "平滑肌",
        "note": "红色细长细胞，参与调节血管管径"
      },
      {
        "en": "Internal elastic membrane",
        "zh": "内弹性膜",
        "note": "动脉图靠近管腔的波浪状弹性界面"
      },
      {
        "en": "External elastic membrane",
        "zh": "外弹性膜",
        "note": "动脉中膜与外膜之间的弹性层次"
      },
      {
        "en": "Elastic fiber",
        "zh": "弹性纤维",
        "note": "动脉壁交错细丝，帮助伸展与回弹"
      },
      {
        "en": "Endothelium",
        "zh": "内皮",
        "note": "紧贴管腔、直接接触血液的细胞衬里"
      },
      {
        "en": "Vasa vasorum",
        "zh": "滋养血管",
        "note": "大血管壁中的小血管，供养管壁组织"
      },
      {
        "en": "Nervi vasorum",
        "zh": "血管神经",
        "note": "管壁中的神经，参与血管活动调节"
      },
      {
        "en": "(a)",
        "zh": "分图a：动脉示意",
        "note": "对应上方左图，重点比较管壁层次"
      },
      {
        "en": "(b)",
        "zh": "分图b：静脉示意",
        "note": "对应上方右图，中膜相对较薄一些"
      },
      {
        "en": "(c)",
        "zh": "分图c：组织切片",
        "note": "对应下方照片，比较真实管壁与管腔"
      }
    ]
  },
  "14-02": {
    "reading_zh": [
      "先看左半幅：红色微动脉分成血毛细管网，再汇入蓝色微静脉；绿色盲端管道夹在组织细胞之间，是淋巴毛细管。黑色小箭头提示组织液在血管外间隙中的移动。",
      "灰色弯箭头把一个局部放大到右侧。那里显示淋巴管壁的内皮细胞彼此重叠，形成可开启的瓣片样边缘；组织液从间隙进入后，才称为管内淋巴。",
      "沿右侧黑箭头向下读，可见防回流的瓣样结构。蓝色胶原纤维把管壁锚定在周围组织中。不要把灰色放大箭头当作液体流向，也不要把绿色管道误认成血管网的另一条静脉。"
    ],
    "labels": [
      {
        "en": "Lymph capillaries in the tissue spaces",
        "zh": "组织间隙中的淋巴毛细管",
        "note": "全图主题，强调管道位于细胞之间"
      },
      {
        "en": "Arteriole",
        "zh": "微动脉",
        "note": "左方红色供血小管，接入毛细血管网"
      },
      {
        "en": "Venule",
        "zh": "微静脉",
        "note": "左图右侧蓝色小管，汇集毛细血管血流"
      },
      {
        "en": "Lymph capillary",
        "zh": "淋巴毛细管",
        "note": "左图绿色盲端小管，收集局部组织液"
      },
      {
        "en": "Lymphatic vessel",
        "zh": "淋巴管",
        "note": "左图较大绿色通路，接续淋巴回流"
      },
      {
        "en": "Tissue fluid",
        "zh": "组织液",
        "note": "左图血管外、细胞间隙中的液体"
      },
      {
        "en": "Tissue cells",
        "zh": "组织细胞",
        "note": "浅黄色带红褐色细胞核的周围细胞"
      },
      {
        "en": "Collagen fiber",
        "zh": "胶原纤维",
        "note": "右图蓝色细丝，将淋巴管壁锚定"
      },
      {
        "en": "Interstitial fluid",
        "zh": "组织间液（组织液）",
        "note": "右图管道外、细胞之间的液体环境"
      },
      {
        "en": "Lymph (interstitial fluid)",
        "zh": "淋巴（进入管内的组织液）",
        "note": "右图绿色管腔内，已进入淋巴回流路线"
      },
      {
        "en": "Endothelial “flaps”",
        "zh": "内皮瓣片样边缘",
        "note": "重叠内皮形成的入口，帮助单向进入"
      },
      {
        "en": "Lymph vessel endothelial cells",
        "zh": "淋巴管内皮细胞",
        "note": "构成绿色管壁，图中可见紫色细胞核"
      },
      {
        "en": "Backflow prevention valve",
        "zh": "防回流瓣样结构",
        "note": "右图下方，帮助限制淋巴向后倒流"
      }
    ]
  },
  "14-03": {
    "reading_zh": [
      "这是从前方看的全身图，人体左侧在画面右边。绿色细线为淋巴管，沿途小结节为淋巴结；先从手足向躯干追踪，再找颈根部淋巴管接入蓝色静脉的位置。",
      "头部另标腺样体和扁桃体，胸前白色组织是胸腺。灰色弯箭头只把胸腺放大到右上角，那里不是淋巴结剖面，也不表示淋巴从胸部流出到身体外。",
      "右侧画面的紫色脾属于人体左上腹；大腿切开的骨显示骨髓。这些器官共同参与免疫相关工作，却不都负责过滤淋巴：淋巴结处理淋巴，脾主要处理血液，骨髓参与血细胞形成。"
    ],
    "labels": [
      {
        "en": "Adenoid",
        "zh": "腺样体（咽扁桃体）",
        "note": "头部较上方黄色组织，邻近鼻咽区域"
      },
      {
        "en": "Tonsil",
        "zh": "扁桃体",
        "note": "头部较下方黄色组织，位于咽部附近"
      },
      {
        "en": "Right lymphatic duct, entering vein",
        "zh": "右淋巴导管汇入静脉",
        "note": "画面左侧颈根部，是人体右侧回流入口"
      },
      {
        "en": "Lymph nodes",
        "zh": "淋巴结群",
        "note": "胸肩及其他区域沿淋巴管分布的小结节"
      },
      {
        "en": "Lymph node",
        "zh": "淋巴结",
        "note": "右侧大腿引线所指的单个绿色结节"
      },
      {
        "en": "Thymus",
        "zh": "胸腺",
        "note": "胸前白色分叶组织，右上为其放大图"
      },
      {
        "en": "Spleen",
        "zh": "脾",
        "note": "画面右侧紫色器官，实际位于左上腹"
      },
      {
        "en": "Bone marrow",
        "zh": "骨髓",
        "note": "大腿骨切开后露出的内部组织区域"
      },
      {
        "en": "Lymph vessel",
        "zh": "淋巴管",
        "note": "四肢与躯干绿色通路，输送淋巴回流"
      }
    ]
  },
  "15-01": {
    "reading_zh": [
      "右上角小人上的横线说明切面高度。主图上方是后方、下方是前方；按常见从足端看的横断显示，人体右侧在画面左边。先用上方椎骨和椎管内脊髓固定方向。",
      "接着沿腹壁内缘找壁腹膜，再沿器官表面找脏腹膜。两层之间的蓝绿间隙表示被夸张放宽的腹膜腔，并非腹腔内真的有这么宽的空水带；膜的反折联系器官与腹壁。",
      "最后比较上方两肾与中下方胃肠：肾在壁腹膜后方，胃肠不同部分与腹膜的关系各异。多个肠管截面属于弯曲肠袢，不代表互不相连的新器官；本图也为教学简化了实际位置。"
    ],
    "labels": [
      {
        "en": "Vertebra",
        "zh": "椎骨",
        "note": "上方后正中骨性结构，用于确定后方"
      },
      {
        "en": "Spinal cord",
        "zh": "脊髓",
        "note": "椎管内中央小圆结构，位于后正中"
      },
      {
        "en": "Kidney",
        "zh": "肾",
        "note": "上方两侧器官，位于壁腹膜的后方"
      },
      {
        "en": "Pancreas",
        "zh": "胰腺",
        "note": "引线指向靠后中央附近的腺性器官"
      },
      {
        "en": "Liver",
